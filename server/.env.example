PORT=5000
# Supabase → Connect → Session pooler URI (URL-encode special characters in the password)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Long random string; changing it logs everyone out
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Optional: API requests per IP per 15 minutes (default 1000)
RATE_LIMIT_MAX=1000
# Only needed for the one-time MySQL -> Supabase migration (scripts/migrate_to_supabase.js)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=islamic_platform
